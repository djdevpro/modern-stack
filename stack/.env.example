# Copie en .env (jamais commité) et remplis.
# DOMAINE et STALWART_ADMIN_PASSWORD : pas de commentaire en fin de ligne, deploie-prod.sh et sw lisent la ligne entière.
COMPOSE_PROFILES=mail,monitoring,iam
# mail., autoconfig., autodiscover., grafana., stalwart., iam. (compose.prod.yaml) ; dokploy. (traefik/prod-dynamic.yml)
DOMAINE=mondomaine.fr

# Mail et supervision
GRAFANA_ADMIN_PASSWORD=change-moi
GRAFANA_ROOT_URL=https://grafana.mondomaine.fr
# admin Stalwart (identifiant : admin)
STALWART_ADMIN_PASSWORD=change-moi

# Identité (Keycloak) : openssl rand -hex 20 pour chaque mot de passe
# admin Keycloak (identifiant : temp-admin au premier démarrage, puis admin : voir README)
KEYCLOAK_ADMIN_PASSWORD=change-moi
KEYCLOAK_DB_PASSWORD=change-moi
KEYCLOAK_MEM_LIMIT=1g

# Versions des images : épinglées dans compose.yaml (étiquette et empreinte), tenues à jour par Dependabot.
