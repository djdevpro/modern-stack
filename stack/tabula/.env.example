TABULA_HOST=tabula.example.com
TABULA_DB_HOST=tabula-db.example.com
OIDC_ISSUER=https://auth.example.com/realms/apps
STDB_DATABASE=tabula-v2
# Set all three to the same validated release, pinned by digest.
TABULA_WEB_IMAGE=ghcr.io/example/tabula-web:latest
TABULA_MODULE_IMAGE=ghcr.io/example/tabula-module:latest
TABULA_MANAGER_IMAGE=ghcr.io/example/tabula-manager:latest
# Managed by terraform/tabula from the existing object-storage credential store.
# Never put real credentials in this example or any VITE_* setting.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
