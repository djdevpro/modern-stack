# FERA (${host}) derrière le Traefik de Dokploy. Rendu, déposé et lancé par Terraform (terraform/fera) dans /opt/fera.
# Les secrets viennent de /opt/fera/.env (0600) : créés une fois sur le serveur, plus les clés S3 déposées par Terraform.
# Tout passe par un seul nom public : l'interface et le SDK (api), et la capture sur /e, /r et /d.
# Mémoire bornée pour un petit serveur partagé : Kafka et ClickHouse en réglages réduits.
name: fera

x-logging: &logging
  driver: json-file
  options:
    max-size: 5m
    max-file: "3"

x-app: &app
  image: ${image}
  restart: unless-stopped
  read_only: true
  tmpfs:
    - /tmp:size=32m
  cap_drop: [ALL]
  security_opt:
    - no-new-privileges:true
  logging: *logging
  environment:
    NODE_NO_WARNINGS: "1"
    KAFKA_BROKERS: fera-kafka:9092
    CLICKHOUSE_URL: http://fera-clickhouse:8123
    CLICKHOUSE_USER: fera
    CLICKHOUSE_PASSWORD: $${CLICKHOUSE_PASSWORD}
    DATABASE_URL: postgres://fera:$${POSTGRES_PASSWORD}@fera-postgres:5432/fera
    S3_ENDPOINT: ${s3_endpoint}
    S3_REGION: ${s3_region}
    S3_BUCKET: ${s3_bucket}
    S3_PREFIX: ${s3_prefix}
    S3_MANAGE_BUCKET: "false"
    S3_FORCE_PATH_STYLE: "false"
    S3_ACCESS_KEY: $${S3_ACCESS_KEY}
    S3_SECRET_KEY: $${S3_SECRET_KEY}
    FERA_ADMIN_EMAIL: ${admin_email}
    FERA_ADMIN_PASSWORD: $${FERA_ADMIN_PASSWORD}
    FERA_SECRET: $${FERA_SECRET}
    FERA_PUBLIC_API: https://${host}
    FERA_PUBLIC_CAPTURE: https://${host}
    RATE_LIMIT_PER_SECOND: "${rate_limit}"
%{ if site_project != null ~}
    FERA_PROJECT_KEY: ${site_project.public_key}
    FERA_PROJECT_NAME: "${site_project.name}"
    FERA_PROJECT_ORIGINS: "${join(",", site_project.origins)}"
%{ endif ~}
  depends_on:
    migrate:
      condition: service_completed_successfully
  networks:
    - fera

services:
  fera-kafka:
    image: apache/kafka:3.9.0
    container_name: fera-kafka
    restart: unless-stopped
    user: root
    environment:
      CLUSTER_ID: 4L6g3nShT-eMCtK--X86sw
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://:9092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://fera-kafka:9092
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@localhost:9093
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "false"
      KAFKA_MESSAGE_MAX_BYTES: 16777216
      KAFKA_REPLICA_FETCH_MAX_BYTES: 16777216
      KAFKA_LOG_RETENTION_HOURS: 72
      KAFKA_LOG_DIRS: /var/lib/kafka/data
      KAFKA_NUM_NETWORK_THREADS: 2
      KAFKA_NUM_IO_THREADS: 2
      KAFKA_HEAP_OPTS: -Xms128m -Xmx384m
    volumes:
      - kafka:/var/lib/kafka/data
    deploy:
      resources:
        limits:
          memory: 768M
          cpus: "1"
    logging: *logging
    networks:
      - fera

  fera-clickhouse:
    image: clickhouse/clickhouse-server:25.3
    container_name: fera-clickhouse
    restart: unless-stopped
    environment:
      CLICKHOUSE_USER: fera
      CLICKHOUSE_PASSWORD: $${CLICKHOUSE_PASSWORD}
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: 1
    ulimits:
      nofile: { soft: 262144, hard: 262144 }
    volumes:
      - clickhouse:/var/lib/clickhouse
      - ./clickhouse/low-memory.xml:/etc/clickhouse-server/config.d/low-memory.xml:ro
    deploy:
      resources:
        limits:
          memory: 1G
          cpus: "1"
    logging: *logging
    networks:
      - fera

  fera-postgres:
    image: postgres:17-alpine
    container_name: fera-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: fera
      POSTGRES_PASSWORD: $${POSTGRES_PASSWORD}
      POSTGRES_DB: fera
    volumes:
      - postgres:/var/lib/postgresql/data
    deploy:
      resources:
        limits:
          memory: 256M
    logging: *logging
    networks:
      - fera

  # Topics, tables, premier projet. Ne touche pas au bucket partagé (S3_MANAGE_BUCKET=false).
  migrate:
    <<: *app
    container_name: fera-migrate
    restart: "no"
    command: ["node", "src/migrate.ts"]
    depends_on: [fera-kafka, fera-clickhouse, fera-postgres]

  # Capture : /e, /r et /d du nom public. Priorité haute devant l'interface.
  capture:
    <<: *app
    container_name: fera-capture
    command: ["node", "src/capture.ts"]
    deploy:
      resources:
        limits:
          memory: 192M
          cpus: "1"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8010/health"]
      interval: 15s
      timeout: 3s
      retries: 4
      start_period: 10s
    networks:
      - fera
      - dokploy-network
    labels:
      - traefik.enable=true
      - traefik.docker.network=dokploy-network
      - traefik.http.routers.fera-capture.rule=Host(`${host}`) && (Path(`/e`) || Path(`/r`) || Path(`/d`))
      - traefik.http.routers.fera-capture.priority=100
      - traefik.http.routers.fera-capture.entrypoints=websecure
      - traefik.http.routers.fera-capture.tls=true
      - traefik.http.routers.fera-capture.tls.certresolver=${cert_resolver}
      - traefik.http.routers.fera-capture.service=fera-capture
      - traefik.http.services.fera-capture.loadbalancer.server.port=8010

  # Interface, API, fichiers du SDK et page de démonstration.
  api:
    <<: *app
    container_name: fera-api
    command: ["node", "src/api.ts"]
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: "1"
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8000/health"]
      interval: 15s
      timeout: 3s
      retries: 4
      start_period: 10s
    networks:
      - fera
      - dokploy-network
    labels:
      - traefik.enable=true
      - traefik.docker.network=dokploy-network
      - traefik.http.routers.fera.rule=Host(`${host}`)
      - traefik.http.routers.fera.entrypoints=websecure
      - traefik.http.routers.fera.tls=true
      - traefik.http.routers.fera.tls.certresolver=${cert_resolver}
      - traefik.http.routers.fera.service=fera
      - traefik.http.services.fera.loadbalancer.server.port=8000
      - traefik.http.routers.fera-http.rule=Host(`${host}`)
      - traefik.http.routers.fera-http.entrypoints=web
      - traefik.http.routers.fera-http.middlewares=redirect-to-https@file
      - traefik.http.routers.fera-http.service=noop@internal

  # Kafka → S3 (sous le préfixe de FERA) + index ClickHouse.
  worker-replay:
    <<: *app
    container_name: fera-worker-replay
    command: ["node", "src/worker-replay.ts"]
    deploy:
      resources:
        limits:
          memory: 384M
          cpus: "1"

  # Kafka → source maps, regroupement, problèmes, webhook.
  worker-errors:
    <<: *app
    container_name: fera-worker-errors
    command: ["node", "src/worker-errors.ts"]
    deploy:
      resources:
        limits:
          memory: 256M
          cpus: "0.5"

networks:
  fera: {}
  dokploy-network:
    external: true

volumes:
  kafka:
  clickhouse:
  postgres:
