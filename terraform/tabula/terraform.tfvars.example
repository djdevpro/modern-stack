ssh_host   = "server.example.com"
ssh_host_key = "ssh-ed25519 REPLACE_WITH_TRUSTED_SERVER_PUBLIC_KEY"
admin_user = "operator"
s3_location = "nbg1"
existing_bucket_name = "existing-app-storage"
# DRIVE_S3_ACCESS_KEY_ID and DRIVE_S3_SECRET_ACCESS_KEY come from setup.py's secret
# store. Reuse the private application bucket, never the Terraform state bucket.
update_policy = {
  repository             = "example/tabula"
  grace_hours            = 4
  check_interval_minutes = 15
  enabled                = true
}
configuration = {
  keycloak_url = "https://iam.example.com"
  frontend_url = "https://tabula.app.example.com"
  backend_url  = "https://tabula-db.app.example.com"
  admin_email  = "owner@example.com"
  smtp_host    = "mail.example.com"
  smtp_user    = "notifications@example.com"
  smtp_from    = "notifications@example.com"
}
